---
import '../styles/global.css';
import Header from "@/components/header.astro";
import SiteFooter from "@/components/footer";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;700&family=Shrikhand&display=swap" rel="stylesheet" />
		<title>{title} — Fellowship Church MD</title>
	</head>
	<body class="min-h-screen bg-[hsl(0,0%,96.08%)] text-[rgb(18,18,18)]">
		<Header />
		<main>
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
