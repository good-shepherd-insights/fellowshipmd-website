---
import '../styles/global.css';
import Header from "@/components/header.astro";
import SiteFooter from "@/components/footer";

interface Props {
  title: string;
}

const { title } = Astro.props;
const slug = Astro.url.pathname.replace(/\/$/, '') || '/index';
const ogImage = new URL(`/open-graph${slug === '/index' ? '/index' : slug}.png`, Astro.site ?? Astro.url.origin).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta property="og:title" content={`${title} — Fellowship Church MD`} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,700;1,700;1,900&family=Shrikhand&display=swap" rel="stylesheet" />
		<title>{title} — Fellowship Church MD</title>
	</head>
	<body data-inner class="min-h-screen bg-[hsl(0,0%,96.08%)] text-[rgb(18,18,18)]">
		<Header />
		<main>
			<slot />
		</main>
		<SiteFooter />
		<script is:inline>
			(() => {
				const fit = () => {
					const w = document.documentElement.clientWidth;
					document.body.style.zoom = w >= 768 && w < 1440 ? String(w / 1440) : "";
				};
				fit();
				addEventListener("resize", fit);
			})();
		</script>
	</body>
</html>
