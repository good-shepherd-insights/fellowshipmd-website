---
import Header from "@/components/header.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;700&family=Shrikhand&display=swap" rel="stylesheet" />
		<title>{title} — Fellowship Church MD</title>
	</head>
	<body class="min-h-screen bg-black text-white">
		<Header />
		<main class="mx-auto max-w-4xl px-6 pb-20 pt-32">
			<h1 class="text-4xl font-bold">{title}</h1>
			<p class="mt-4 opacity-60">Page content from fellowshipmd.church has not been ported yet.</p>
		</main>
	</body>
</html>
