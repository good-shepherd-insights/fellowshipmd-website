---
import Layout from "@/layouts/page.astro";
---

<Layout title="Prayer">
  <section class="relative overflow-hidden bg-[rgb(18,18,18)] px-6 py-16 text-[hsl(0,0%,96.08%)] md:px-0 md:py-0 md:h-[1435px]">
    <img
      src="/images/pages/prayerbg.webp"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="relative mx-auto max-w-[1440px] md:h-[1435px]">
      <h1 class="mx-auto max-w-[899px] text-center font-heading text-[clamp(36px,4.71vw,67.84px)] leading-[1.05] md:absolute md:left-[271px] md:top-[188px] md:w-[899px] md:text-[67.84px]">
        Thank you for trusting us to stand with you.
      </h1>

      <!-- Visual replica of the Squarespace prayer-request form (JS-injected on the live site; non-functional here) -->
      <form class="mx-auto mt-12 w-full max-w-[558px] md:absolute md:left-[441px] md:top-[509px] md:mt-0 md:h-[602px] md:w-[558px]" onSubmit="return false">
        <div class="pt-[28px]">
          <span class="block pb-1 text-base leading-[24px]">Name</span>
          <div class="grid grid-cols-2 gap-[10px]">
            <label class="block">
              <span class="block text-xs leading-[27px]">First Name <span class="text-neutral-500">(required)</span></span>
              <input type="text" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base text-black" />
            </label>
            <label class="block">
              <span class="block text-xs leading-[27px]">Last Name <span class="text-neutral-500">(required)</span></span>
              <input type="text" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base text-black" />
            </label>
          </div>
        </div>
        <label class="mt-5 block">
          <span class="block pb-1 text-base leading-[24px]">Phone</span>
          <input type="tel" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base text-black" />
        </label>
        <label class="mt-5 block">
          <span class="block pb-1 text-base leading-[24px]">Email</span>
          <input type="email" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base text-black" />
        </label>
        <label class="mt-5 block">
          <span class="block pb-1 text-base leading-[24px]">Prayer Request</span>
          <textarea class="block h-[100px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base text-black"></textarea>
        </label>
        <label class="mt-5 block">
          <span class="block pb-1 text-base leading-[24px]">Additional Questions</span>
          <input type="text" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base text-black" />
        </label>
        <div class="mt-5 flex justify-center">
          <button type="submit" class="rounded-[10px] bg-white px-[20.8px] py-4 text-base text-black">
            Submit
          </button>
        </div>
      </form>

      <div class="mt-12 flex justify-center gap-3 md:absolute md:left-[384px] md:top-[1271px] md:mt-0 md:w-[671px]">
        <a href="https://www.instagram.com/fellowshipchurchmd/" target="_blank" rel="noopener" aria-label="Instagram" class="text-white">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href="https://www.facebook.com/fellowshipchurchmd" target="_blank" rel="noopener" aria-label="Facebook" class="text-white">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
