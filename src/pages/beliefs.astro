---
import Layout from "@/layouts/page.astro";
---

<Layout title="Beliefs">
  <!-- 1. spacer -->
  <div class="h-[120px] md:h-[191px]"></div>

  <!-- 2. Our Vision -->
  <section class="px-6 pb-20 md:px-0 md:pb-0">
    <div class="relative mx-auto max-w-[1440px] md:h-[671px]">
      <h2 class="font-black italic text-[clamp(44px,8.58vw,123.6px)] leading-none tracking-[-0.02em] md:absolute md:left-[384px] md:top-[161px] md:w-[671px]">
        Our Vision
      </h2>
      <p class="mt-8 text-base leading-6 md:absolute md:left-[271px] md:top-[321px] md:mt-0 md:w-[899px]">
        They were continually devoting themselves to the apostles&rsquo; teaching
        and to fellowship, to the breaking of bread and to prayer. Everyone kept
        feeling a sense of awe, and many wonders and signs were taking place
        through the apostles. And all the believers were together and had all
        things in common; and they would sell their property and possessions and
        share them with all, to the extent that anyone had need.&nbsp;<strong>&nbsp;</strong>Day
        by day continuing with one mind in the temple, and breaking bread from
        house to house, they were taking their meals together with gladness and
        sincerity of heart, praising God and having favor with all the people.
        And the Lord was adding to their number day by day those who were being
        saved.<br /><br /><strong>Acts 2:42-47 - NASB</strong>
      </p>
    </div>
  </section>

  <!-- 3. Our Mission -->
  <section class="bg-[rgb(234,230,225)] px-6 py-16 md:px-0 md:py-0">
    <div class="relative mx-auto max-w-[1440px] md:h-[801px]">
      <img
        src="/images/pages/fc24-2.webp"
        alt="Two people embracing outdoors"
        class="mx-auto w-full max-w-[564px] md:absolute md:left-[212px] md:top-[124px] md:mx-0 md:h-[553px] md:w-[564px] md:max-w-none md:object-cover"
      />
      <h2 class="font-black italic mt-10 text-center text-4xl leading-none tracking-[-1.074px] text-[rgb(174,30,50)] md:absolute md:left-[833px] md:top-[153px] md:mt-0 md:w-[338px] md:text-left md:text-[53.7px]">
        Our Mission
      </h2>
      <div class="mt-8 bg-[hsl(0,0%,96.08%)] p-5 md:absolute md:left-[604px] md:top-[208px] md:mt-0 md:h-[302px] md:w-[570px]">
        <h2 class="font-black italic text-center text-[32px] leading-[0.93] tracking-[-0.94px] text-[rgb(174,30,50)] md:max-w-[445px] md:text-left md:text-[47.104px] md:leading-[1.11]">
          We Are Here to Equip the Saints for the Work of Service and the
          Building of the Body of Christ.
        </h2>
      </div>
    </div>
  </section>

  <!-- 4. Culture band -->
  <section class="px-6 py-20 md:px-0 md:py-0 md:h-[339px]">
    <div class="relative mx-auto flex max-w-[1440px] items-center justify-center md:h-full">
      <h2 class="font-black italic text-center text-3xl leading-none tracking-[-0.77px] md:text-[38.5px]">
        We are more and more becoming a culture that emanates Jesus
      </h2>
    </div>
  </section>

  <!-- 5. Explore our values CTA -->
  <section class="relative h-[360px] md:h-[499px]">
    <img
      src="/images/pages/fc1-bg.webp"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="relative mx-auto h-full max-w-[1440px]">
      <div class="flex h-full items-center justify-center md:absolute md:left-[555px] md:top-[183px] md:h-[69px] md:w-[330px] md:items-start md:justify-center">
        <a
          href="/values"
          class="rounded-[10px] border border-white px-[21px] py-4 text-base text-white transition hover:bg-white hover:text-black"
        >
          Explore our values
        </a>
      </div>
    </div>
  </section>
</Layout>
