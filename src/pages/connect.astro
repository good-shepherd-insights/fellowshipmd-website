---
import Layout from "@/layouts/page.astro";
---

<Layout
  title="Connect"
  description="Want to be more involved? Church Center is our main hub for communication with members — download the app and get started."
>
  <!-- Section 1: Want to be more involved? (light, bordered box) -->
  <section class="px-6 py-16 md:px-0 md:py-0">
    <div class="relative mx-auto max-w-[1440px] md:h-[793px]">
      <img
        src="/images/pages/cc.webp"
        alt="Church Center"
        width="501"
        height="69"
        class="mx-auto w-[300px] md:absolute md:left-1/2 md:top-[228px] md:mx-0 md:w-[501px] md:-translate-x-1/2"
      />
      <div class="mt-10 border border-black px-6 py-8 md:absolute md:left-1/2 md:top-[348px] md:mt-0 md:h-[430px] md:w-[785px] md:-translate-x-1/2 md:p-0">
        <p class="text-center font-bold md:absolute md:left-1/2 md:top-[49px] md:w-[687px] md:-translate-x-1/2 md:text-[55.5px] md:leading-[1.01]">
          Want to be more involved?
        </p>
        <div class="mt-6 space-y-4 text-center text-base leading-6 md:absolute md:left-1/2 md:top-[120px] md:mt-0 md:w-[687px] md:-translate-x-1/2 md:space-y-0">
          <p>Church Center is our main hub for communication with members.</p>
          <p class="md:mt-[16px]">
            Add <em>Fellowship Church</em> to your Church Center account to stay updated,
            view the event calendar, give online, and submit prayer requests&mdash;all in
            one place!
          </p>
          <p class="md:mt-[16px]">Download the app and tap the link below to get started.</p>
        </div>
        <div class="mt-10 flex justify-center md:absolute md:left-1/2 md:top-[330px] md:mt-0 md:block md:h-[69px] md:w-[330px] md:-translate-x-1/2">
          <a
            href="https://fellowshipchurchmd.churchcenter.com/login?return=https://fellowshipchurchmd.churchcenter.com/registrations"
            target="_blank"
            rel="noopener"
            class="mx-auto block w-fit rounded-[10px] bg-[rgb(174,30,50)] px-[20.8px] py-4 text-base leading-[1.2] text-white"
          >
            Join Church Center
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Contact Info (background image, centered text) -->
  <section class="relative overflow-hidden bg-[rgb(174,30,50)] px-6 py-16 text-white md:px-0 md:py-0 md:h-[420px]">
    <img
      src="/images/pages/connectbg.webp"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="relative mx-auto max-w-[1440px] md:h-[420px]">
      <h2 class="text-center font-heading text-[47.104px] leading-[1.1] md:absolute md:left-1/2 md:top-[100px] md:w-[735px] md:-translate-x-1/2">
        Contact Info
      </h2>
      <p class="mt-6 text-center text-[22.912px] leading-8 md:absolute md:left-1/2 md:top-[177px] md:mt-0 md:w-[735px] md:-translate-x-1/2 md:leading-[34.3px]">
        <strong>Address:</strong> Son of David Congregation<br />
        18403 Woodfield Rd, Gaithersburg, MD 20879<br />
        <strong>Email:&nbsp; </strong><a href="mailto:Connect@fellowshipmd.church" class="underline decoration-1 underline-offset-2">Connect@fellowshipmd.church</a>
      </p>
    </div>
  </section>

  <!-- Section 3: social cards -->
  <section class="px-6 pb-16 md:px-[43px] md:pb-[48px] md:pt-[47px]">
    <div class="mx-auto grid max-w-[1354px] gap-[11px] md:grid-cols-3">
      <a href="https://www.facebook.com/fellowshipchurchmd" target="_blank" rel="noopener" class="overflow-hidden rounded-[20px]">
        <img src="/images/pages/fb.webp" alt="Facebook" width="444" height="550" class="h-[550px] w-full object-cover" />
      </a>
      <a href="https://www.instagram.com/fellowshipchurchmd/" target="_blank" rel="noopener" class="overflow-hidden rounded-[20px]">
        <img src="/images/pages/ig.webp" alt="Instagram" width="444" height="550" class="h-[550px] w-full object-cover" />
      </a>
      <a href="https://www.youtube.com/channel/UC9l9Gk14Uy1OzuLZJT1hb9A" target="_blank" rel="noopener" class="overflow-hidden rounded-[20px]">
        <img src="/images/pages/yt.webp" alt="YouTube" width="444" height="550" class="h-[550px] w-full object-cover" />
      </a>
    </div>
  </section>
</Layout>
