---
import Layout from "@/layouts/page.astro";
---

<Layout title="Contact">
  <section class="px-6 py-16 md:px-0 md:py-0">
    <div class="relative mx-auto max-w-[1440px] md:h-[913px]">
      <div class="md:absolute md:left-[43px] md:top-[188px] md:w-[558px]">
        <h2 class="font-heading text-[47.104px] leading-[1.1]">Contact us</h2>
        <p class="mt-8 text-base leading-6">
          If you have any questions or comments, please don&rsquo;t hesitate to reach out
          using the contact form. You can also reach us by email or phone from 9 a.m. to
          5 p.m. PST, Monday through Friday. <br /><br /><strong>Email</strong><br />
          email@example.com<br /><br /><strong>Phone</strong><br />(555) 555-5555
        </p>
        <div class="mt-10 flex items-center gap-3 md:mt-[11px]">
          <a href="https://www.instagram.com/fellowshipchurchmd/" target="_blank" rel="noopener" aria-label="Instagram" class="text-black">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href="https://www.facebook.com/fellowshipchurchmd" target="_blank" rel="noopener" aria-label="Facebook" class="text-black">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Visual replica of the Squarespace form (JS-injected on the live site; non-functional here) -->
      <form class="mt-12 md:absolute md:left-[782px] md:top-[188px] md:mt-0 md:h-[508px] md:w-[614px]" onSubmit="return false">
        <div class="pt-[28px]">
          <div class="grid grid-cols-2 gap-[10px]">
            <label class="block">
              <span class="block text-xs leading-[27px]">First Name <span class="text-neutral-500">(required)</span></span>
              <input type="text" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base" />
            </label>
            <label class="block">
              <span class="block text-xs leading-[27px]">Last Name <span class="text-neutral-500">(required)</span></span>
              <input type="text" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base" />
            </label>
          </div>
        </div>
        <label class="mt-5 block">
          <span class="block pb-1 text-base leading-[24px]">Email <span class="text-neutral-500">(required)</span></span>
          <input type="email" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base" />
        </label>
        <label class="mt-5 block">
          <span class="block pb-1 text-base leading-[24px]">Subject <span class="text-neutral-500">(required)</span></span>
          <input type="text" class="block h-[46px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base" />
        </label>
        <label class="mt-5 block">
          <span class="block pb-1 text-base leading-[24px]">Message <span class="text-neutral-500">(required)</span></span>
          <textarea class="block h-[100px] w-full border border-black bg-[rgb(250,250,250)] p-[10px] text-base"></textarea>
        </label>
        <button type="submit" class="mt-5 rounded-[10px] bg-[rgb(174,30,50)] px-[20.8px] py-4 text-base leading-[1.2] text-white">
          Submit
        </button>
      </form>
    </div>
  </section>
</Layout>
