---
import '../styles/global.css';
import Header from '@/components/header.astro';
import Demo from '@/components/demo';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;700&family=Shrikhand&display=swap" rel="stylesheet" />
		<meta name="description" content="New here? Learn about who we are and what we believe — prayer and care, serving together, and upcoming events at Fellowship Church MD." />
		<link rel="canonical" href="https://fellowship.equipchurch.center/" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Fellowship Church MD" />
		<meta property="og:title" content="Fellowship Church MD" />
		<meta property="og:description" content="New here? Learn about who we are and what we believe — prayer and care, serving together, and upcoming events at Fellowship Church MD." />
		<meta property="og:url" content="https://fellowship.equipchurch.center/" />
		<meta property="og:image" content="https://fellowship.equipchurch.center/open-graph/index.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Fellowship Church MD" />
		<meta name="twitter:image" content="https://fellowship.equipchurch.center/open-graph/index.png" />
		<title>Meet Jesus. Be Transformed. | Fellowship Church | Rockville, MD</title>
	</head>
	<body class="bg-black text-white">
		<Header />
		<main>
			<Demo client:load />
		</main>
	</body>
</html>
